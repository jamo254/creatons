<!-- Navigation -->
<nav class="bg-white/95 backdrop-blur-md border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <%= link_to root_path, class: "flex items-center space-x-2" do %>
          <div class="h-8 w-8 bg-gradient-to-r from-purple-600 to-indigo-600 rounded-lg flex items-center justify-center">
            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <span class="text-xl font-bold text-gray-900">Creaton</span>
        <% end %>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <%= link_to "Discover", "#discover", class: "text-gray-600 hover:text-purple-600 font-medium transition duration-200" %>
        <%= link_to "Categories", "#categories", class: "text-gray-600 hover:text-purple-600 font-medium transition duration-200" %>
        <%= link_to "How it Works", "#how-it-works", class: "text-gray-600 hover:text-purple-600 font-medium transition duration-200" %>
        <%= link_to "Pricing", "#pricing", class: "text-gray-600 hover:text-purple-600 font-medium transition duration-200" %>
      </div>

      <!-- Auth Section -->
      <div class="flex items-center space-x-4">
        <% if user_signed_in? %>
          <!-- Signed In User -->
          <div class="hidden md:flex items-center space-x-4">
            <div class="relative group">
              <button class="flex items-center space-x-2 text-gray-700 hover:text-purple-600 font-medium">
                <div class="h-8 w-8 bg-gradient-to-r from-purple-500 to-indigo-500 rounded-full flex items-center justify-center text-white text-sm font-semibold">
                  <%= current_user.email.first.upcase %>
                </div>
                <span class="hidden lg:block">Hi, <%= current_user.email.split('@').first.capitalize %></span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              
              <!-- Dropdown Menu -->
              <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="py-2">
                  <%= link_to "Dashboard", "#", class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
                  <%= link_to "Profile", "#", class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
                  <%= link_to "Settings", "#", class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
                  <hr class="my-2">
                  <%= link_to "Sign Out", "/users/sign_out", data: { "turbo-method": :delete }, class: "block px-4 py-2 text-sm text-red-600 hover:bg-red-50" %></div>
              </div>
            </div>
          </div>
          
          <!-- Mobile User Menu -->
          <div class="md:hidden">
            <div class="h-8 w-8 bg-gradient-to-r from-purple-500 to-indigo-500 rounded-full flex items-center justify-center text-white text-sm font-semibold">
              <%= current_user.email.first.upcase %>
            </div>
          </div>
        <% else %>
          <!-- Not Signed In -->
          <div class="flex items-center space-x-4">
            <%= link_to "Log In", new_user_session_path, 
                class: "text-gray-600 hover:text-purple-600 font-medium transition duration-200" %>
            <%= link_to "Sign Up", new_user_registration_path, 
                class: "bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:from-purple-700 hover:to-indigo-700 transition duration-200 transform hover:scale-105" %>
          </div>
        <% end %>

        <!-- Mobile Menu Button -->
        <button class="md:hidden p-2 text-gray-600 hover:text-purple-600">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

