</section>

<!-- Categories Section -->
<section id="categories" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-gray-900 mb-4">Explore Creative Categories</h2>
      <p class="text-xl text-gray-600">Find the perfect creator for your next project</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      <% [
        { icon: "🎨", name: "Graphic Design", count: "2.1K" },
        { icon: "📝", name: "Writing", count: "1.8K" },
        { icon: "🎵", name: "Music", count: "1.2K" },
        { icon: "📹", name: "Video", count: "980" },
        { icon: "📸", name: "Photography", count: "1.5K" },
        { icon: "💻", name: "Development", count: "850" }
      ].each do |category| %>
        <div class="bg-gradient-to-br from-gray-50 to-gray-100 p-6 rounded-2xl hover:shadow-lg transition duration-300 cursor-pointer group">
          <div class="text-3xl mb-3 group-hover:scale-110 transition duration-300"><%= category[:icon] %></div>
          <h3 class="font-semibold text-gray-900 mb-1"><%= category[:name] %></h3>
          <p class="text-sm text-gray-600"><%= category[:count] %> creators</p>
        </div>
      <% end %>
    </div>
  </div>
</section>

